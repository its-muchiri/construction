# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=construction_co_ke
DB_USER=construction_app
DB_PASSWORD=

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://construction.co.ke/api/v1/payments/mpesa/callback

# Card gateway (common here given high transaction values)
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=

# App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Signs bearer-token auth (src/Core/Auth.php) — generate with:
# php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
